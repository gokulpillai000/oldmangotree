# ========================================================
# OLDMANGOTREE — ENVIRONMENT CONFIGURATION
# ========================================================

# 1. Blogger Integration (Public Feed - Optional)
NEXT_PUBLIC_BLOGGER_URL=""

# 2. Supabase Integration (Primary CMS Database & Media Storage)
# Obtain from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"

# 3. Authentication & Editorial Security (Server-Side Secrets)
# HMAC-SHA256 signing key for session cookies and Bearer tokens
AUTH_SECRET="generate-a-strong-random-secret-key"
# Editorial Desk PIN for /publisher portal access
EDITORIAL_DESK_PIN="your-editorial-pin"
# Optional master password override for publisher accounts
EDITORIAL_ADMIN_PASSWORD=""
# Optional SHA-256 digest of `omt_pin_v1:<PIN>` for static export fallback
NEXT_PUBLIC_EDITORIAL_PIN_HASH=""

# 4. Cache Revalidation Secret
# Used to trigger /api/revalidate?secret=YOUR_SECRET to purge server caches
REVALIDATION_SECRET="generate-a-strong-revalidation-secret"

# 5. Reader Feedback / Letter to Editor Email
EDITORIAL_FEEDBACK_EMAIL="editorial@oldmangotree.media"

# Optional: Resend API Key for direct email sending (https://resend.com)
RESEND_API_KEY=""

# Optional: Web3Forms Access Key for free email dispatch (https://web3forms.com)
WEB3FORMS_ACCESS_KEY=""

# 6. Content Display Mode
NEXT_PUBLIC_HIDE_DUMMY_CONTENT="true"
