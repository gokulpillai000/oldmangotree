# ========================================================
# OLDMANGOTREE — ENVIRONMENT CONFIGURATION
# ========================================================

# 1. Blogger Integration (Public Feed - No API Key Needed)
# Replace with your actual Blogspot URL
NEXT_PUBLIC_BLOGGER_URL="https://yourblogname.blogspot.com"

# 2. Supabase Integration (User Auth, Bookmarks & Subscriptions)
# Obtain from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# 3. Cache Revalidation Secret
# Used to trigger /api/revalidate?secret=YOUR_SECRET to instantly update content
REVALIDATION_SECRET="oldmangotree-secret"

# 4. Reader Feedback / Letter to Editor Email
# Destination email where reader letters are dispatched
EDITORIAL_FEEDBACK_EMAIL="editorial@oldmangotree.media"

# Optional: Resend API Key for direct email sending (https://resend.com)
RESEND_API_KEY=""

# Optional: Web3Forms Access Key for free email dispatch (https://web3forms.com)
WEB3FORMS_ACCESS_KEY=""
